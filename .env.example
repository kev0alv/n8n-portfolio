# Stride & Soul — environment
# Copy to .env (git-ignored) and fill in:   copy .env.example .env
# Never paste these values in a chat, a screenshot or a commit.

# --- n8n login (owner account is created automatically on first boot)
N8N_OWNER_EMAIL=kev.alvareze@gmail.com
N8N_OWNER_PASSWORD=

# --- Encrypts every credential inside n8n's database.
#     Generate once (PowerShell):  -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
#     Never change it after the first boot, or n8n can no longer read its credentials.
N8N_ENCRYPTION_KEY=

# --- Postgres: admin account, and the account the workflows use for the store data
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
SOLE_APP_PASSWORD=

# --- Google Cloud / BigQuery (sandbox, no billing)
#     Service-account key goes in secrets/bq-service-account.json
GCP_PROJECT_ID=
BQ_DATASET=stride_soul

# --- LLMs
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- Telegram (bot "Sole", created with @BotFather)
TELEGRAM_BOT_TOKEN=
#     Numeric chat id that receives error alerts (yours)
TELEGRAM_ONCALL_CHAT_ID=

# --- Salt for hashing Telegram user ids before they reach BigQuery (GDPR-friendly).
#     Any long random string. Changing it later breaks the link to past customers.
USER_HASH_SALT=

# --- ngrok: public HTTPS address so Telegram can reach the bot (docs/SETUP.md, step 8)
NGROK_AUTHTOKEN=
#     Your free static domain, e.g. something-random.ngrok-free.app (no https://)
NGROK_DOMAIN=
#     Same domain with https:// and a trailing slash
N8N_WEBHOOK_URL=http://localhost:5678/
#     Starts the ngrok container. Leave empty until NGROK_* are filled in.
COMPOSE_PROFILES=

# --- Workflows to publish on boot (space-separated ids). Filled in during construction.
ACTIVATE_WORKFLOWS=

# --- Tuning
TZ=America/El_Salvador
N8N_VERSION=2.42.4
