# Copia este archivo a .env y cambia los valores. NUNCA subas el .env a git.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=n8n

# Genera una con: openssl rand -hex 32
# Guardala bien: sin ella no se pueden descifrar las credenciales guardadas.
N8N_ENCRYPTION_KEY=

# Local: localhost / http / http://localhost:5678/
# VPS con dominio: n8n.tudominio.com / https / https://n8n.tudominio.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

TIMEZONE=America/El_Salvador
