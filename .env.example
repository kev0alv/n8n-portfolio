# Copy to .env and change the passwords:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- n8n login (created automatically on first boot)
N8N_OWNER_EMAIL=demo@example.com
N8N_OWNER_PASSWORD=ChangeMe123

# --- Encrypts credentials inside n8n's database. Generate with: openssl rand -hex 32
#     Do not change it after the first boot, or n8n can no longer read its credentials.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
OPS_WRITER_PASSWORD=change-me-writer
OPS_ANALYST_PASSWORD=change-me-analyst

# --- Grafana admin (dashboards are also viewable without logging in)
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Optional: "Ask your data" AI agent. Free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional: send SLA and error alerts to Telegram (talk to @BotFather for a token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning
TZ=America/El_Salvador
SIMULATOR_NEW_CASES_PER_RUN=3
N8N_VERSION=2.42.4
