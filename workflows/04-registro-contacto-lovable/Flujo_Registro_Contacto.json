    {
      "id": "7af5557b-6aca-416a-bfb4-1274c9045416",
      "name": "Code_Calcula_Duplicado_91dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "parameters": {
        "jsCode": "const webhookData = $('Webhook a Lovable').item.json.body;\nconst nombre = webhookData.nombre;\nconst email = webhookData.email;\nconst area = webhookData.area;\nconst comentario = webhookData.comentario;  // ✅ corregido: era .mensaje, el campo real es .comentario\nconst previas = $input.all().map(i => i.json).filter(row => row.Email);\nlet duplicado = false;\nlet fechaMasReciente = null;\nfor (const row of previas) {\n  if (row.Email !== email || row.Área !== area) continue;\n  const fechaAplico = new Date(row.Fecha.replace(' ', 'T'));\n  const diasPasados = (Date.now() - fechaAplico.getTime()) / (1000 * 60 * 60 * 24);\n  if (diasPasados < 91) {\n    duplicado = true;\n    if (!fechaMasReciente || fechaAplico > fechaMasReciente) fechaMasReciente = fechaAplico;\n  }\n}\nlet estado, mensaje;\nif (duplicado) {\n  const habilitado = new Date(fechaMasReciente);\n  habilitado.setDate(habilitado.getDate() + 91);\n  const habilitadoStr = habilitado.toLocaleDateString('es-SV');\n  estado = 'Rechazado - Duplicado';\n  mensaje = `Gracias por tu interés en trabajar con nosotros, revisamos tuviste una aplicación recientemente, si aún no has recibido un correo de seguimiento, por favor espera a que nuestro equipo de reclutamiento procese tu solicitud, de otra manera, favor vuelve a intentar a partir de ${habilitadoStr}.`;\n} else {\n  estado = 'Pendiente';\n  mensaje = `Gracias por tu aplicación, recibirás un correo electrónico de confirmación a ${email}. Nuestro equipo de reclutamiento se estará contactando contigo en los próximos 10 días de negocio.`;\n}\n\nreturn [{ json: { nombre, email, area, comentario, duplicado, estado, mensaje } }];"
      },
      "alwaysOutputData": true
    },
