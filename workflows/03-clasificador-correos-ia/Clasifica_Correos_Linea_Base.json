    {
      "id": "819b38ee-bca8-4807-8039-17fa1bbcf897",
      "name": "Calcular Metricas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ],
      "parameters": {
        "jsCode": "// Configuración de zona horaria y formato estándar\nconst ZONA_HORARIA = 'America/El_Salvador';\nconst FORMATO_ESTANDAR = 'yyyy-MM-dd HH:mm:ss';\n\nconst tiempoFinMs = Date.now();\n\n// 1. Extraer los datos de inicio DIRECTAMENTE del nodo \"Marca Inicio\"\nconst datosInicio = $(\"Marca Inicio\").first().json;\n\n// 2. Obtener marca_inicio y forzar conversión a número\nconst marcaInicio = Number(datosInicio.marca_inicio);\n\n// 3. Obtener la fecha de inicio formateada o calcularla\nconst inicioFEstandar = datosInicio.Inicio_f_estandar \n  || $now.constructor.fromMillis(marcaInicio).setZone(ZONA_HORARIA).toFormat(FORMATO_ESTANDAR);\n\n// 4. Generar fecha y hora de finalización actual\nconst finFEstandar = $now.setZone(ZONA_HORARIA).toFormat(FORMATO_ESTANDAR);\n\n// 5. Cálculos de duración\nconst duracionMs = Math.max(0, tiempoFinMs - marcaInicio);\nconst duracionSegundos = parseFloat((duracionMs / 1000).toFixed(3));\n\nreturn [{\n  json: {\n    nombre_del_flujo_de_trabajo: \"CLASIFICA CORREOS - LINEA BASE\",\n    estado: \"éxito\",\n    inicio: inicioFEstandar,\n    final: finFEstandar,\n    duracion_ms: duracionMs,\n    duracion_s: duracionSegundos,\n    mensaje_de_error: \"\"\n  }\n}];"
      }
    },
