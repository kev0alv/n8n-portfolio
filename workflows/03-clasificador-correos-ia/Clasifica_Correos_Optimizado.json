    {
      "id": "1c337264-3283-45ad-8c0e-f531d966c9a7",
      "name": "Calcular Metricas por Correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        432
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// M5 + M7: una fila de métricas POR CORREO, formato de fecha único\nconst ZONA = 'America/El_Salvador';\nconst FORMATO = 'yyyy-MM-dd HH:mm:ss';\nconst ETIQUETAS = {\n  'Label_8262435743091244180': 'INFORMACIÓN Y VENTAS',\n  'Label_4112253398573021820': 'SOPORTE',\n  'Label_7410029221856401669': 'RECLAMOS',\n  'Label_5242405656681736864': 'OTROS',\n  'Label_1504488627485043226': 'PROVEEDORES'\n};\nconst RESPALDO = 'Clasificador Gemini (respaldo)';\n\nconst inicioMs = Number($('Marca Inicio').first().json.marca_inicio);\nconst finMs = Date.now();\n\nconst categoria = ($json.labelIds || []).map(id => ETIQUETAS[id]).find(Boolean) || 'SIN ETIQUETA';\n\n// Ruta: qué modelo clasificó este correo (M2)\nlet ruta = 'GROQ';\ntry {\n  if ($(RESPALDO).isExecuted) {\n    for (let salida = 0; salida < 6; salida++) {\n      if ($(RESPALDO).all(salida).some(it => it.json.id === $json.id)) { ruta = 'GEMINI (respaldo)'; break; }\n    }\n  }\n} catch (e) { /* el respaldo no corrió */ }\n\nreturn {\n  json: {\n    Fecha_Hora: DateTime.fromMillis(finMs).setZone(ZONA).toFormat(FORMATO),\n    Workflow: 'CLASIFICA CORREOS - OPTIMIZADO',\n    Estado: 'éxito',\n    Inicio: DateTime.fromMillis(inicioMs).setZone(ZONA).toFormat(FORMATO),\n    Final: DateTime.fromMillis(finMs).setZone(ZONA).toFormat(FORMATO),\n    Error: '',\n    Duracion_s: Number(((finMs - inicioMs) / 1000).toFixed(3)),\n    'duración_ms': finMs - inicioMs,\n    Categoria: categoria,\n    Ruta: ruta,\n    Registrado_por: 'OPTIMIZADO'\n  }\n};"
      }
    },
