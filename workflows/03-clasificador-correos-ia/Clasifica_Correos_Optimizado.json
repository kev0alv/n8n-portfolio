        "categories": {
          "categories": [
            {
              "category": "INFORMACIÓN Y VENTAS",
              "description": "Correos de clientes con consultas sobre productos o servicios, precios, disponibilidad, características, promociones, cotizaciones, pedidos o intención de compra."
            },
            {
              "category": "SOPORTE",
              "description": "Solicitudes de ayuda o asistencia de clientes relacionadas con el uso, configuración, funcionamiento, instalación, acceso a cuentas o resolución de problemas de un producto o servicio."
            },
            {
              "category": "RECLAMOS",
              "description": "Correos donde el cliente expresa una queja, inconformidad o problema con un producto, servicio, pedido, entrega, cobro o atención recibida, y espera una solución."
            },
            {
              "category": "OTROS",
              "description": "Correos de personas que no corresponden claramente a información y ventas, soporte o reclamos, como consultas generales, comunicaciones administrativas, propuestas, agradecimientos o mensajes sin contenido claro."
            },
            {
              "category": "PROVEEDORES",
              "description": "Correos enviados por proveedores de servicios y plataformas que usa la empresa. Se identifican por el DOMINIO DEL REMITENTE (línea 'De:'): spotify.com, supabase.com, hubspot.com, google.com, googlemail.com, lovable.dev, deepseek.com o docker.com, incluyendo cualquier subdominio (por ejemplo alerts.spotify.com, accounts.google.com, notifications.hubspot.com, sc.mail.deepseek.com, notify.docker.com). Si el remitente pertenece a uno de esos dominios, clasifica SIEMPRE aquí, sin importar el contenido (notificaciones, alertas de seguridad, facturación, promociones, newsletters o mensajes de vendedores)."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "batching": {
            "batchSize": 3,
            "delayBetweenBatches": 25000
          }
        }
