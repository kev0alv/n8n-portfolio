      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Workflow de errores: registra cada fallo en la misma hoja de métricas\nconst ZONA_HORARIA = 'America/El_Salvador';\nconst FORMATO = 'dd-MM-yyyy HH:mm:ss';\n\nconst e = $input.first().json;\nconst ahora = $now.setZone(ZONA_HORARIA).toFormat(FORMATO);\n\nconst nodo = e.execution?.lastNodeExecuted || e.trigger?.error?.node?.name || 'desconocido';\nconst mensaje = e.execution?.error?.message || e.trigger?.error?.message || 'sin mensaje';\nconst enlace = e.execution?.url || '';\n\nreturn [{\n  json: {\n    Fecha_Hora: ahora,\n    Workflow: e.workflow?.name || 'desconocido',\n    Estado: 'error',\n    Inicio: ahora,\n    Final: '',\n    Error: `[${nodo}] ${mensaje}` + (enlace ? ` | ${enlace}` : ''),\n    Duracion_s: '',\n    'duración_ms': '',\n    Categoria: '',\n    Ruta: '',\n    Registrado_por: 'ERROR_HANDLER'\n  }\n}];"
      }
    },
