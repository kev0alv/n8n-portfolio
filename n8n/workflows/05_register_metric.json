    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One row per execution. Never stores raw e-mails or phone numbers.\nconst r = $json;\nconst mask = (t) => t == null || t === '' ? null : String(t)\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[email]')\n  .replace(/\\+?\\d[\\d\\s-]{6,}\\d/g, '[phone]')\n  .slice(0, 500);\nconst started = r.started_at ? new Date(r.started_at) : null;\nconst finished = r.finished_at ? new Date(r.finished_at) : new Date();\nconst ok = (d) => d && !isNaN(d);\nreturn { json: {\n  execution_id: String(r.execution_id ?? 'n/a'),\n  workflow: String(r.workflow || 'unknown'),\n  status: ['success', 'error', 'invalid_response'].includes(r.status) ? r.status : 'error',\n  started_at: ok(started) ? started.toISOString() : null,\n  finished_at: finished.toISOString(),\n  duration_s: ok(started) ? (finished - started) / 1000 : null,\n  node: r.node || null,\n  error: mask(r.error),\n  user_hash: r.user_hash || null,\n  registered_by: r.registered_by === 'ERROR_HANDLER' ? 'ERROR_HANDLER' : 'MAIN_FLOW',\n} };"
      },
