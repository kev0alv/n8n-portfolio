    {
      "parameters": {
        "jsCode": "// One metric row for the whole run; per-table detail kept in \"tables\".\nconst results = $input.all().map(({ json: j }) => ({\n  table: j.configuration && j.configuration.load && j.configuration.load.destinationTable.tableId,\n  job: j.jobReference && j.jobReference.jobId,\n  rows: Number((j.statistics && j.statistics.load && j.statistics.load.outputRows) || 0),\n  error: (j.status && j.status.errorResult && j.status.errorResult.message) || null,\n}));\nconst failed = results.filter((r) => r.error);\nconst started = Number($execution.customData.get('started_ms'));\nreturn [{ json: {\n  execution_id: String($execution.id),\n  workflow: $workflow.name,\n  status: failed.length ? 'error' : 'success',\n  started_at: started ? new Date(started).toISOString() : null,\n  finished_at: new Date().toISOString(),\n  node: failed.length ? 'Get_Job_Status' : null,\n  error: failed.length ? failed.map((f) => f.table + ': ' + f.error).join(' | ') : null,\n  user_hash: null,\n  registered_by: 'MAIN_FLOW',\n  failed_count: failed.length,\n  tables: results,\n} }];"
      },
