    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "07c00000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.status.state }}",
              "rightValue": "DONE",
