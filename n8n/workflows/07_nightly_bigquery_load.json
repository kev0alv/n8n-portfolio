    {
      "parameters": {
        "jsCode": "// 01 (tables) then 02 (views), straight from the repo: the only copy of the schema.\n$execution.customData.set('started_ms', String(Date.now()));\nconst files = $input.all().map((i) => i.json);\nif (files.some((f) => !f.fileName)) throw new Error('SQL file without fileName');\nfiles.sort((a, b) => a.fileName.localeCompare(b.fileName));\nreturn [{ json: { files: files.map((f) => f.fileName), script: files.map((f) => f.data).join('\\n') } }];"
      },
      "id": "07000000-0000-4000-8000-000000000005",
      "name": "Build_DDL_Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {},
        "method": "POST",
        "url": "={{ 'https://bigquery.googleapis.com/bigquery/v2/projects/' + $env.GCP_PROJECT_ID + '/queries' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.script, useLegacySql: false, location: 'US', timeoutMs: 60000 }) }}"
      },
      "id": "07000000-0000-4000-8000-000000000006",
      "name": "Apply_DDL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "googleApi": {
          "id": "bigQuery00000001",
          "name": "BigQuery - n8n-bigquery"
        }
      }
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {},
        "method": "POST",
        "url": "={{ 'https://bigquery.googleapis.com/bigquery/v2/projects/' + $env.GCP_PROJECT_ID + '/queries' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"SELECT c.table_name, TO_JSON_STRING(ARRAY_AGG(STRUCT(c.column_name AS name, c.data_type AS type) ORDER BY c.ordinal_position)) AS cols FROM `\" + $env.BQ_DATASET + \".INFORMATION_SCHEMA.COLUMNS` c JOIN `\" + $env.BQ_DATASET + \".INFORMATION_SCHEMA.TABLES` t USING (table_name) WHERE t.table_type = 'BASE TABLE' GROUP BY c.table_name ORDER BY c.table_name\", useLegacySql: false, location: 'US', timeoutMs: 60000 }) }}"
      },
      "id": "07000000-0000-4000-8000-000000000007",
      "name": "Get_Columns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "googleApi": {
          "id": "bigQuery00000001",
          "name": "BigQuery - n8n-bigquery"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One export query per BigQuery table. The columns come from BigQuery\n// (01_dataset_and_tables.sql), so names and contacts are never exported.\nconst res = $input.first().json;\nif (!res.jobComplete) throw new Error('Column query did not finish');\nconst ident = (s) => { if (!/^[a-z_][a-z0-9_]*$/.test(s)) throw new Error('Bad identifier: ' + s); return s; };\nreturn (res.rows || []).map((r) => {\n  const table = ident(r.f[0].v);\n  const cols = JSON.parse(r.f[1].v);\n  const pairs = cols.map(({ name, type }) => {\n    const c = '\"' + ident(name) + '\"';\n    const v = type === 'TIMESTAMP'\n      ? \"to_char(\" + c + \" AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS.US') || ' UTC'\"\n      : c;\n    return \"'\" + name + \"', \" + v;\n  }).join(', ');\n  const sql = \"SELECT '\" + table + \"' AS table_name, count(*)::int AS n, \" +\n    \"coalesce(string_agg(json_build_object(\" + pairs + \")::text, E'\\\\n'), '') AS ndjson FROM \\\"\" + table + \"\\\"\";\n  return { json: { table, sql } };\n});"
      },
      "id": "07000000-0000-4000-8000-000000000008",
      "name": "Build_Export_SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "07000000-0000-4000-8000-000000000009",
      "name": "Each_Table",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "id": "07000000-0000-4000-8000-000000000010",
      "name": "Export_Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1760,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "pgStrideSoul0001",
          "name": "Postgres - stride_soul"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Load job body: JSON config + NDJSON rows. An empty table sends an empty file (loads 0 rows).\nconst b = 'ss' + Date.now();\nconst meta = { configuration: {\n  labels: { n8n_execution: String($execution.id), workflow: '07_nightly_load' },\n  load: {\n    destinationTable: { projectId: $env.GCP_PROJECT_ID, datasetId: $env.BQ_DATASET, tableId: $json.table_name },\n    sourceFormat: 'NEWLINE_DELIMITED_JSON',\n    writeDisposition: 'WRITE_TRUNCATE',\n    createDisposition: 'CREATE_NEVER',   // tables come from 01_dataset_and_tables.sql only\n  },\n} };\nconst body = '--' + b + '\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n' + JSON.stringify(meta) + '\\r\\n' +\n  '--' + b + '\\r\\nContent-Type: application/octet-stream\\r\\n\\r\\n' + $json.ndjson + '\\r\\n--' + b + '--';\nreturn { json: { table: $json.table_name, rows: $json.n, boundary: b, body } };"
      },
      "id": "07000000-0000-4000-8000-000000000011",
      "name": "Build_Multipart",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ]
    },
