{
  "id": "opsAlertsWf00001",
  "name": "03 · SLA breach alerts (bottleneck monitor)",
  "active": true,
  "nodes": [
    {
      "id": "03769b3e-73ca-53df-baf7-3a5d334d55ae",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -260
      ],
      "parameters": {
        "content": "## Real-time SLA alerts\nEvery 2 minutes, finds open cases that have been in a stage longer than its SLA and records **one** alert per case and stage.\n\nNew alerts are grouped into a single message. Telegram is optional: set `TELEGRAM_BOT_TOKEN` and `TELEGRAM_CHAT_ID` in `.env`; otherwise alerts are stored in the `alerts` table only.",
        "width": 420,
        "height": 300,
        "color": 7
      }
    },
    {
      "id": "40f06aca-2c7c-5b63-ac24-6c75cefb2e2c",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "de35328c-28ac-5149-957d-6fe8009aede3",
      "name": "Record new breaches",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alerts (case_id, stage, minutes_in_stage, sla_minutes, severity)\nSELECT case_id, current_stage, round(minutes_in_stage)::int, sla_minutes,\n       CASE WHEN minutes_in_stage > 2 * sla_minutes THEN 'critical' ELSE 'warning' END\nFROM v_open_cases\nWHERE breached\nON CONFLICT (case_id, stage) DO NOTHING   -- one alert per case and stage, never repeated\nRETURNING case_id, stage, minutes_in_stage, sla_minutes, severity;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgOpsWriter00001",
          "name": "Postgres ops (writer)"
        }
      }
    },
    {
      "id": "28976e79-7a71-5916-8c86-4d96ddb5ede0",
      "name": "Group into one message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// One grouped message per run instead of one message per case (no alert storms).\nconst rows = $input.all().map(i => i.json);\nconst byStage = {};\nfor (const r of rows) (byStage[r.stage] ??= []).push(r);\n\nconst lines = Object.entries(byStage)\n  .sort((a, b) => b[1].length - a[1].length)\n  .map(([stage, list]) => {\n    const worst = list.reduce((a, b) => (b.minutes_in_stage > a.minutes_in_stage ? b : a));\n    const critical = list.filter(r => r.severity === 'critical').length;\n    return `• ${stage}: ${list.length} new breach(es), ${critical} critical. Worst: ${worst.case_id} at ${worst.minutes_in_stage} min (SLA ${worst.sla_minutes})`;\n  });\n\nreturn [{ json: {\n  new_alerts: rows.length,\n  text: `⚠️ SLA breaches detected\\n${lines.join('\\n')}\\n\\nDashboard: http://localhost:3000`,\n  telegram: Boolean($env.TELEGRAM_CHAT_ID),\n} }];"
      }
    },
    {
      "id": "3203ca58-e37a-5b43-9713-46236d1fc5d3",
      "name": "Telegram configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
